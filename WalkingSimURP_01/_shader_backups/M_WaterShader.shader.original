		_DeepColor( "DeepColor", Color ) = ( 0, 0, 0, 0 )
		_SurfaceColor( "SurfaceColor", Color ) = ( 0, 0, 0, 0 )
		_RefractionStrength( "RefractionStrength", Float ) = 0
		_ReftactionOffset( "ReftactionOffset", Vector ) = ( 0, 0, 0, 0 )
