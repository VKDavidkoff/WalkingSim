				UNITY_VERTEX_OUTPUT_STEREO
			};

			CBUFFER_START(UnityPerMaterial)
			float4 _DeepColor;
			float4 _SurfaceColor;
			float2 _ReftactionOffset;
			float _Waves_UV1;
			float _NormalScale;
			float _Waves_UV2;
			float _RefractionStrength;
			float _Brightness;
			float _Metallic;
			float _Distance;
